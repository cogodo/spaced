# Environment Configuration for Spaced Learning Backend
# Copy this file to .env and fill in your actual values

# --- Application Configuration ---

# Environment (development, staging, production)
ENVIRONMENT="development"

# Backend URL for voice agent worker
# Auto-detected based on environment, but can be explicitly set
# Development: http://localhost:8000
# Staging: https://api.staging.getspaced.app
# Production: https://api.getspaced.app
BACKEND_URL="http://localhost:8000"

# Debug mode (True for development, False for production)
DEBUG=True

# Server host and port
HOST="0.0.0.0"
PORT=8000

# Log level (debug, info, warning, error)
LOG_LEVEL="info"

# --- Firebase Configuration ---

# Firebase project ID
FIREBASE_PROJECT_ID="your-firebase-project-id"

# Firebase credentials - use ONE of the following options:

# Option 1 (Railway/Heroku): Base64-encoded service account JSON
# Generate with: ./scripts/encode_firebase_creds.sh /path/to/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS_BASE64="base64-encoded-json-here"

# Option 2: Raw JSON string (alternative for cloud platforms)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Option 3 (Local development): Path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS="/path/to/your/service-account-key.json"

# Firebase Web API Key (required for voice agent service-to-service authentication)
# This is the same API key used by your web app for Firebase Auth
# You can find this in your Firebase Console > Project Settings > General > Web API Key
FIREBASE_WEB_API_KEY="your-firebase-web-api-key-here"

# --- Redis Configuration ---

# Redis connection URL
# For local development: redis://localhost:6379
# For production: redis://your-redis-host:6379
REDIS_URL="redis://localhost:6379"

# --- LLM Provider Configuration ---

# Use Anthropic Claude instead of OpenAI (recommended)
USE_ANTHROPIC=True

# --- Anthropic Configuration (Primary) ---

# Your API key for Anthropic Claude.
# Required when USE_ANTHROPIC=True
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# Model selection (defaults shown)
# ANTHROPIC_MODEL="claude-sonnet-4-20250514"         # For tutor, scoring, generation
# ANTHROPIC_FAST_MODEL="claude-3-5-haiku-20241022"   # For clarification, refinement
ANTHROPIC_REQUEST_TIMEOUT_SECONDS=30
ANTHROPIC_MAX_RETRIES=2

# --- OpenAI Configuration (Fallback / Voice Agent) ---

# Your API key for OpenAI.
# Required for voice agent (STT/Whisper) even when using Anthropic for chat.
OPENAI_API_KEY="your-openai-api-key-here"

# Legacy settings (only used if USE_ANTHROPIC=False)
USE_COMBINED_LLM=False
USE_RESPONSES_API=True
OPENAI_REQUEST_TIMEOUT_SECONDS=12
OPENAI_MAX_RETRIES=2

# --- Voice-to-Voice Configuration ---

# Cartesia API key for text-to-speech (TTS) functionality.
# This is required for the voice-to-voice chatbot feature.
CARTESIA_API_KEY="your-cartesia-api-key-here"

# LiveKit API credentials for creating rooms and managing voice sessions.
# Get these from your LiveKit Cloud dashboard or self-hosted server.
LIVEKIT_API_KEY="your-livekit-api-key-here"
LIVEKIT_API_SECRET="your-livekit-api-secret-here"

# LiveKit server URL. For LiveKit Cloud, this will be provided in your dashboard.
# For self-hosted, use your server's WebSocket URL.
# Example: "wss://your-project.livekit.cloud"
LIVEKIT_SERVER_URL="wss://your-livekit-server.livekit.cloud"

# For compatibility with LiveKit CLI tools, set LIVEKIT_URL as well
LIVEKIT_URL="wss://your-livekit-server.livekit.cloud"

# Deepgram API key for speech-to-text (STT) - optional alternative to OpenAI Whisper.
# If not provided, the system will use OpenAI Whisper for transcription.
# Deepgram often provides better real-time performance and cost efficiency.
DEEPGRAM_API_KEY="your-deepgram-api-key-here"

# --- CORS Configuration ---

# A comma-separated list of allowed origins for Cross-Origin Resource Sharing (CORS).
# This is primarily for production. In development mode (DEBUG=True), a permissive
# list of local origins is used automatically.
# Example: CORS_ORIGINS="https://your-production-domain.com,https://your-staging-domain.com"
CORS_ORIGINS=""

# --- Cache Configuration ---

# Time-to-live for topic cache in seconds
TOPIC_CACHE_TTL_SECONDS=300 