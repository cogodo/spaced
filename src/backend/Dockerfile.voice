FROM python:3.13-slim

WORKDIR /app

# Install system dependencies (voice needs more)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libsndfile1 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY pyproject.toml .

# Install Python dependencies WITH voice extras
RUN pip install --no-cache-dir -e ".[voice]"

# Copy application code
COPY . .

# Health check port for Railway
ENV PORT=8080
EXPOSE 8080

# Voice agent with health server for Railway
CMD ["python", "voice_agent_worker.py", "start"]
